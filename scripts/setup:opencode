#!/bin/bash

set -e

echo "🔧 Setting up OpenCode..."
echo ""

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# Where the generated artifacts land. Defaults to the repo root; `PAVILIO_OPENCODE_OUT`
# redirects them (and skips the global sync) so the generator can be driven into a
# throwaway directory — that is how the wrapper contract test exercises it without
# touching the developer's real config.
OUT_ROOT="${PAVILIO_OPENCODE_OUT:-$REPO_ROOT}"
OC_CMD_DIR="$OUT_ROOT/.opencode/commands"
OC_JSON="$OUT_ROOT/opencode.json"

# Skills renamed or removed upstream, from skills/RETIRED (one name per line, `#` comments).
# Only a plain skill slug counts, and a name that is a live skill again is skipped, so the
# cleanup below can only ever touch the exact artifacts generated for a retired skill.
retired_skills() {
    [ -f skills/RETIRED ] || return 0
    grep -E '^[a-z0-9][a-z0-9._-]*$' skills/RETIRED | while read -r name; do
        [ -e "skills/$name/SKILL.md" ] || echo "$name"
    done
}

# 1. Generate one opencode command wrapper per skill (dynamic, no hardcoded list) —
#    mirrors setup:claude-code. Wrappers use the absolute skill path so the command
#    resolves regardless of the invoking cwd.
mkdir -p "$OC_CMD_DIR"
echo "📋 Generating opencode command wrappers from skills/ ..."
if [ -d "skills" ]; then
    for skill_md in skills/*/SKILL.md; do
        [ -e "$skill_md" ] || continue
        cmd="$(basename "$(dirname "$skill_md")")"
        printf 'Read and follow the instructions in `%s/%s` exactly.\n' "$REPO_ROOT" "$skill_md" > "$OC_CMD_DIR/${cmd}.md"
        echo "  ✓ ${cmd}.md"
    done
fi

# Wrappers are only ever added, and opencode.json is rebuilt from them: dropping a retired
# skill's wrapper here also drops its command entry below.
GLOBAL="$HOME/.config/opencode"
for name in $(retired_skills); do
    if [ -f "$OC_CMD_DIR/${name}.md" ]; then
        rm -f "$OC_CMD_DIR/${name}.md"
        echo "  ✗ removed retired ${name}.md"
    fi
    if [ -z "${PAVILIO_OPENCODE_OUT:-}" ] && [ -f "$GLOBAL/commands/${name}.md" ]; then
        rm -f "$GLOBAL/commands/${name}.md"
        echo "  ✗ removed retired ${name}.md from $GLOBAL/commands/"
    fi
done

# 2. Register the wrappers in opencode.json's `command` block. opencode reads
#    slash-commands from this block; regenerating it means every skill is wired
#    automatically. Other keys (permission, mcp, …) are preserved. opencode.json
#    is created minimally only if absent.
echo ""
echo "🧩 Registering commands in opencode.json ..."
python3 - "$REPO_ROOT" "$OUT_ROOT" <<'PY'
import json, os, glob, re, sys

root, out_root = sys.argv[1], sys.argv[2]
cmd_dir = os.path.join(out_root, ".opencode", "commands")
cfg_path = os.path.join(out_root, "opencode.json")

cfg = {}
if os.path.exists(cfg_path):
    with open(cfg_path) as f:
        cfg = json.load(f)
cfg.setdefault("$schema", "https://opencode.ai/config.json")

commands = {}
for path in sorted(glob.glob(os.path.join(cmd_dir, "*.md"))):
    name = os.path.splitext(os.path.basename(path))[0]
    with open(path) as f:
        body = f.read().strip()
    # Metadata lives in the source skill, not the generated one-line wrapper.
    desc = agent = model = None
    skill_path = os.path.join(root, "skills", name, "SKILL.md")
    if os.path.exists(skill_path):
        with open(skill_path) as sf:
            m = re.match(r"^---\n(.*?)\n---\n", sf.read(), re.S)
        if m:
            for line in m.group(1).splitlines():
                if ":" in line:
                    k, v = line.split(":", 1)
                    k, v = k.strip(), v.strip()
                    if k == "description":
                        desc = v
                    elif k == "agent":
                        agent = v
                    elif k == "model":
                        model = v
    entry = {"template": body}
    if desc:
        entry["description"] = desc
    if agent:
        entry["agent"] = agent
    if model:
        entry["model"] = model
    commands[name] = entry

cfg["command"] = commands
with open(cfg_path, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")

print(f"  ✓ {len(commands)} commands registered in opencode.json")
PY

# 3. Sync wrappers to the global opencode config, if present, so commands also
#    resolve when opencode is launched outside this repo.
if [ -z "${PAVILIO_OPENCODE_OUT:-}" ] && [ -d "$GLOBAL" ]; then
    mkdir -p "$GLOBAL/commands"
    cp "$OC_CMD_DIR"/*.md "$GLOBAL/commands/" 2>/dev/null || true
    echo "  ✓ Synced wrappers → $GLOBAL/commands/"
fi

echo ""
echo "✅ OpenCode setup complete!"
echo ""
echo "Commands are registered in opencode.json — launch opencode from this repo to use them."
echo ""
