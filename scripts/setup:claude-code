#!/bin/bash

set -e

# Every path below is relative to the repo root, whatever cwd the script was started from.
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

echo "🔧 Setting up Claude Code..."
echo ""

# Check if Claude Code CLI is installed
if ! command -v claude &> /dev/null; then
    echo "❌ Claude Code CLI not found"
    echo ""
    echo "Install Claude Code from: https://claude.com/claude-code"
    echo ""
    read -p "Install now? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
    echo "Please install Claude Code and run this script again"
    exit 1
fi

echo "✓ Claude Code CLI found"
echo ""

# Skills renamed or removed upstream, from skills/RETIRED (one name per line, `#` comments).
# Only a plain skill slug counts, and a name that is a live skill again is skipped, so the
# cleanup below can only ever touch the exact artifacts generated for a retired skill.
retired_skills() {
    [ -f skills/RETIRED ] || return 0
    # Strip only a trailing CR (CRLF files); a CR inside a name must not join it into another name.
    awk '{ sub(/\r$/, "") } 1' skills/RETIRED | grep -E '^[a-z0-9][a-z0-9._-]*$' | while read -r name; do
        [ -e "skills/$name/SKILL.md" ] || echo "$name"
    done
}

# Create .claude directory structure
mkdir -p .claude/commands
echo "✓ Created .claude/commands/ directory"

# Copy every skill in skills/ as a Claude Code slash command (no hardcoded list)
echo "📋 Installing skill definitions..."
if [ -d "skills" ]; then
    for skill_md in skills/*/SKILL.md; do
        [ -e "$skill_md" ] || continue
        cmd="$(basename "$(dirname "$skill_md")")"
        cp "$skill_md" ".claude/commands/${cmd}.md"
        echo "  ✓ ${cmd}.md (from ${skill_md})"
    done
fi

# Symlink every skill into the user-level skills dir (~/.claude/skills/). This is
# what makes a skill model-INVOCABLE by name — both Claude Code and opencode
# discover skills from here. Slash-command wrappers alone (above / opencode.json)
# are NOT enough: without this symlink the model gets "Skill <name> not found".
SKILLS_DIR="$HOME/.claude/skills"
mkdir -p "$SKILLS_DIR"
echo "🔗 Linking skills into $SKILLS_DIR ..."
if [ -d "skills" ]; then
    for skill_md in skills/*/SKILL.md; do
        [ -e "$skill_md" ] || continue
        skill_dir="$(cd "$(dirname "$skill_md")" && pwd)"
        name="$(basename "$skill_dir")"
        ln -sfn "$skill_dir" "$SKILLS_DIR/$name"
        echo "  ✓ ${name} -> ${skill_dir}"
    done
fi

# Setup only adds, so a retired skill's command and skill link would linger forever.
for name in $(retired_skills); do
    if [ -f ".claude/commands/${name}.md" ]; then
        rm -f ".claude/commands/${name}.md"
        echo "  ✗ removed retired command ${name}.md"
    fi
    # Only a link, and only one that is dangling or points at this repo's skills/<name>: a real
    # directory, or a link another clone still serves the skill from, is not ours to delete.
    # Resolved with `cd && pwd -P` (BSD readlink has no -f); a path that fails to resolve
    # is never treated as ours.
    link="$SKILLS_DIR/$name"
    link_target="$(cd "$link" 2>/dev/null && pwd -P)" || link_target=""
    own_target="$(cd "$REPO_ROOT/skills/$name" 2>/dev/null && pwd -P)" || own_target=""
    if [ -L "$link" ] && { [ ! -e "$link" ] || \
        { [ -n "$link_target" ] && [ "$link_target" = "$own_target" ]; }; }; then
        rm -f "$SKILLS_DIR/$name"
        echo "  ✗ unlinked retired skill ${name}"
    fi
done

# Create .claude/settings.json if it doesn't exist
if [ ! -f ".claude/settings.json" ]; then
    cat > ".claude/settings.json" << 'EOFCONFIG'
{
  "temperature": 0.7,
  "max_tokens": 4096,
  "tools": {
    "browser": true,
    "file_system": true,
    "bash": true
  },
  "session_tracking": true,
  "session_directory": "progress/",
  "auto_memory": true,
  "memory_file": "CLAUDE.md"
}
EOFCONFIG
    echo "✓ Created .claude/settings.json"
    echo "  ⚠️  Note: Use '/model' command to select your preferred model on first run"
else
    echo "✓ .claude/settings.json already exists"
fi

# Verify CLAUDE.md exists
if [ -f "CLAUDE.md" ]; then
    echo "✓ CLAUDE.md found (startup instructions)"
else
    echo "⚠️  CLAUDE.md not found (Claude won't have startup instructions)"
fi

# Verify AGENTS.md exists
if [ -f "AGENTS.md" ]; then
    echo "✓ AGENTS.md found (project registry)"
else
    echo "⚠️  AGENTS.md not found (Claude won't know about projects)"
fi

echo ""
echo "✅ Claude Code setup complete!"
echo ""
echo "Next steps:"
echo "1. Test: cd $(pwd) && claude"
echo "2. Claude should read AGENTS.md at startup"
echo "3. Try: /note [topic] to use commands"
echo ""
