{
  "name": "pavilio",
  "version": "1.0.0",
  "description": "Pavilio — a dashboard for the AI coding agents running on your machine. Local-first, provider-agnostic project workspace.",
  "main": "index.js",
  "scripts": {
    "export-project": "./scripts/export-project-to-notebooklm.sh",
    "bootstrap": "./scripts/bootstrap",
    "setup:shortcut": "./scripts/setup:shortcut",
    "setup:codex": "./scripts/setup:codex",
    "setup:claude-code": "./scripts/setup:claude-code",
    "setup:opencode": "./scripts/setup:opencode",
    "install:speech": "./scripts/install:speech",
    "install:kokoro": "./scripts/install:kokoro",
    "sync": "bash scripts/update.sh",
    "pull": "bash scripts/pull",
    "test": "pnpm -C panel test",
    "test:slow": "pnpm -C panel test:slow",
    "test:all": "pnpm -C panel test:all",
    "lint": "pnpm -C panel lint",
    "knip": "pnpm -C panel knip",
    "build": "pnpm -C panel build",
    "dev": "pnpm -C panel dev",
    "start": "./scripts/panel start",
    "stop": "./scripts/panel stop",
    "reboot": "./scripts/panel restart",
    "status": "./scripts/panel status"
  },
  "keywords": [
    "project-management",
    "ai-agents",
    "claude",
    "kilocode",
    "copilot",
    "workflow",
    "multi-project"
  ],
  "author": "Greg Motyl",
  "license": "MIT",
  "packageManager": "pnpm@10.18.1"
}
