{
  "name": "panel",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/dev.ts",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "lint": "tsc --noEmit --pretty false -p tsconfig.json && tsc --noEmit --pretty false -p tsconfig.node.json",
    "knip": "knip --include files",
    "preview": "vite preview",
    "test": "vitest run --project browser --project node",
    "test:slow": "vitest run --project node-slow",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "sync": "bash ../scripts/update.sh",
    "postinstall": "node scripts/fix-node-pty-perms.cjs",
    "prepare": "bash ../scripts/install-git-hooks"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/multer": "^2.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "^6.0.0",
    "anytts": "0.4.0",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "fuse.js": "^7.3.0",
    "highlight.js": "^11.11.1",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.8.0",
    "mermaid": "^11.14.0",
    "multer": "^2.1.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "turndown": "^7.2.4",
    "ws": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "knip": "5.88.1",
    "postcss": "^8.5.9",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
